# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 100

# Markdown overrides (preserve trailing spaces for line breaks)
[*.md]
trim_trailing_whitespace = false

# Web Frontend overrides
[*.{js,jsx,ts,tsx,vue,html,css,json}]
indent_size = 4
insert_final_newline = true
